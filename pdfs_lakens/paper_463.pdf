<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Hipatia Press · Mantenimiento</title>
<style>
  /* ---------- Ajustos generals ---------- */
  html,body{
    margin:0;height:100%;
    font-family:'Open Sans',Arial,sans-serif;
    color:#000;text-align:center;
    display:flex;flex-direction:column;
    justify-content:center;align-items:center;             /* color de reserva */
    position:relative;overflow:hidden; /* per al pseudo-element */
  }

  /* ---------- Imatge de fons amb blur ---------- */
  body::before{
    content:"";
    position:fixed;inset:0;            /* top:0 right:0 bottom:0 left:0 */
    background:url("bg.jpg") center/cover no-repeat;
    filter:blur(6px);
    transform:scale(1.05);            /* evita vores nítides */
    z-index:-1;                       /* darrere del contingut */
  }

  /* ---------- Branding ---------- */
  .brand{display:flex;align-items:center;gap:1.5rem;margin-bottom:4rem}
  .brand img{height:120px}
  .brand h1{margin:0;font-size:3rem;color:#4a2b6d;font-weight:700}

  /* ---------- Missatge ---------- */
  h2{font-size:2.8rem;font-weight:600;margin:0 1rem 2rem}
  p{margin:.3rem 0;font-size:1.1rem}

  footer{position:absolute;bottom:1.5rem;width:100%}
</style>
</head>
<body>

  <!-- Capçalera -->
  <div class="brand">
    <img src="logo.png" alt="Hipatia Press logo">
  </div>

  <!-- Missatge principal -->
  <h2>Estamos en modo mantenimiento&nbsp;/&nbsp;We are in maintenance mode.</h2>
  <p>El sitio estará disponible el 25&nbsp;de&nbsp;agosto. ¡Gracias por su paciencia!</p>
  <p>The site will be available on August 25th. Thank you for your patience!</p>

  <footer>© HIPATIA PRESS 2025</footer>
</body>
</html>
