# Regex to detect t-tests with reported effect sizes
test_es_regex <- "\\bt\\s*\\(\\s*\\d+(\\.\\d+)?\\s*\\)\\s*=\\s*-?\\d+(\\.\\d{1,4})?\\s*,\\s*p\\s*[<>=≤≥]{1,2}\\s*(0?\\.\\d+|1|0)\\s*,\\s*(?:cohen'?s\\s*)?(d|g|r|f²?|η²|η²p|omega²|ω²|partial\\s+η²)\\s*[=≈<>\u2264\u2265]{1,3}\\s*-?\\d+(\\.\\d+)?"
text_found_es <- search_text(papers, test_es_regex)
View(text_found_es)
# Regex to detect tests with reported effect sizes
test_es_regex <- "\\bF\\s*\\(\\s*\\d+(\\.\\d+)?\\s*,\\s*\\d+(\\.\\d+)?\\s*\\)\\s*=\\s*-?\\d+(\\.\\d{1,4})?\\s*,\\s*p\\s*[<>=≤≥]{1,2}\\s*(0?\\.\\d+|1|0)\\s*,\\s*(?:cohen'?s\\s*)?(d|dz|ds|g|Hedges'?\\s*g|f²|η\\s*2|η\\s*p\\s*2|η²|η²p|omega²|ω²|partial\\s+η²)\\s*[=≈<>\u2264\u2265]{1,3}\\s*-?\\d+(\\.\\d+)?"
