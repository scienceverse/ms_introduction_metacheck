regex_data_repositories <- "https://(?:(?:www\\.)?github(?:\\.com)?|(?:www\\.)?osf\\.io|(?:dx\\.)?doi\\.org10\\.[0-9]+/[^/\\s]*|(?:www\\.)?figshare\\.com|(?:www\\.)?zenodo\\.org|(?:www\\.)?datadryad\\.org|(?:www\\.)?kaggle\\.com|(?:www\\.)?cdc\\.gov|data\\.mendeley\\.com|hdl\\.handle\\.net|nhiss\\.nhis\\.or\\.kr|(?:www\\.)?gitlab(?:\\.com)?|dep\\.mohw\\.gov\\.tw|(?:www\\.)?ukbiobank\\.ac\\.uk|(?:www\\.)?ices\\.on\\.ca|knhanes|(?:www\\.)?openicpsr(?:\\.org)?|(?:www\\.)?who\\.int|(?:www\\.)?stats\\.gov|proteomecentral(?:\\.org)?|seer\\.cancer\\.gov|portal\\.gdc\\.cancer\\.gov|databank(?:\\.org)?|archive\\.ics\\.uci\\.edu(?:m)?|biolincc\\.nhlbi\\.nih\\.gov|physionet\\.org|(?:www\\.)?hcup-us\\.ahrq\\.gov|(?:www\\.)?datatilsynet(?:\\.dk)?|bitbucket\\.org|gwas\\.mrcieu\\.ac\\.uk|nhird\\.nhri(?:\\.org\\.tw)?|mics\\.unicef\\.org|massive\\.ucsd\\.edu|data\\.world|ghdx\\.healthdata\\.org|(?:www\\.)?census\\.gov|(?:www\\.)?ibge\\.gov\\.br|datacompass\\.lshtm\\.ac\\.uk|(?:www\\.)?scb\\.se|etikprovning(?:\\.se)?|mimic(?:\\.physionet\\.org)?|simtk\\.org|microdat(?:\\.no)?|doi\\.pangaea\\.de|(?:www\\.)?icddrb\\.org|(?:www\\.)?measuredhs(?:\\.com)?|beta\\.ukdataservice\\.ac\\.uk|reshare\\.ukdataservice\\.ac\\.uk|flowrepository\\.org|(?:www\\.)?mhlw\\.go\\.jp|dataview\\.ncbi\\.nlm\\.nih(?:\\.gov)?|(?:www\\.)?share-project\\.org|(?:www\\.)?socialstyrelsen\\.se|pubmlst\\.org|(?:www\\.)?clinicalstudydatarequest\\.com|(?:www\\.)?ddbj\\.nig\\.ac\\.jp|bigd\\.big\\.ac\\.cn|data\\.csmar\\.com|data\\.humdata\\.org|ec\\.europa\\.eu(?:/)?eurostat|(?:www\\.)?cpc\\.unc\\.edu|(?:www\\.)?resdac\\.org|digital\\.nhs(?:\\.uk)?|fieldresearch\\.msf\\.org|(?:www\\.)?tropmedres\\.ac(?:\\.th)?|(?:www\\.)?morphosource\\.org|(?:www\\.)?uniprot\\.org|datasus\\.saude\\.gov(?:\\.br)?|ourworldindata\\.org|(?:www\\.)?pmadata\\.org|(?:www\\.)?naturalearthdata\\.com|(?:www\\.)?ncbi\\.nlm\\.nih\\.gov(?:geo|genbank)?|data\\.(?:[a-z]+\\.)?[a-z]+|dataverse\\.(?:[a-z]+\\.)?[a-z]+|opendata(?:\\.[a-z]+\\.[a-z]+)?|research(?:\\.[a-z]+\\.[a-z]+)?)"
text_found_link <- search_text(papers, "http|www", return = "sentence")
text_found_repositories <- search_text(text_found_link, regex_data_repositories, return = "sentence")
text_found_repositories
text_found_link
text_found_github <- search_text(papers, "github")
text_found_github
View(text_found_link)
#| label: setup
library(papercheck)
library(knitr)
library(kableExtra)
library(osfr)
library(httr)
library(jsonlite)
library(dplyr)
library(stringi)
library(ggplot2)
library(purrr)
library(stringr)
library(rvest)
library(xml2)
library(rcrossref)
library(here)
library(readxl)
library(tidyr)
library(janitor)
library(crayon)
library(httr)   # For downloading HTML
library(fs)     # For file handling
library(openalexR)
options(openalexR.mailto = "D.Lakens@tue.nl")
library(progress)
load("data/psychscience_2014_2024_xml.RData")
load("data/psychscience_openalex_2014_2024.RData")
load("data/psychscience_crossref_2014_2024.RData")
# Downloasded in the chunk osf_retrieve, but stored as it takes a long time to run
all_osf_file_info_psych_science <- readRDS("data/all_osf_file_info_psych_science.rds")
# Extract data from the XML object
dois <- unname(sapply(xml, function(x) x[["info"]][["doi"]]))
# Grobid does a bad job on DOIs, we need to remove the end.
dois <- gsub("pss.*$", "", dois)
dois <- gsub("jour.*$", "", dois)
dois <- gsub("www.*$", "", dois)
ids <- unname(sapply(xml, function(x) x[["id"]]))
filenames <- unname(sapply(xml, function(x) x[["info"]][["filename"]]))
filenames <- basename(filenames) # remove file path.
submissions <- unname(sapply(xml, function(x) {
if (!is.null(x[["info"]][["submission"]])) {
paste(unlist(x[["info"]][["submission"]]), collapse = ", ")
} else {
NA
}
}))
doi <- paste("10.1177/", sub("\\.xml$", "", filenames), sep = "")
url <- paste0("https://doi.org/",doi)
# Combine into a dataframe
psych_science <- data.frame(
doi = doi,
id = ids,
filename = filenames,
submission = submissions,
url = url,
stringsAsFactors = FALSE
)
# Add crossref information
psych_science <- dplyr::left_join(psych_science, results[, c("url", "title", "is.referenced.by.count", "issued", "reference.count")], by = c("url" = "url"))
# Add openalex information
works_from_dois <- works_from_dois %>% rename(openalex_id = id)
psych_science <- dplyr::left_join(psych_science, works_from_dois[, c("url", "openalex_id", "cited_by_count", "is_retracted", "oa_status")], by = c("url" = "url")
)
# Extract year from the 'issued' column
psych_science <- psych_science %>%
mutate(year = as.integer(substr(issued, 1, 4)))  # Extract the first 4 characters (year)
# Downloasded in the chunk osf_retrieve, but stored as it takes a long time to run
all_osf_file_info_psych_science <- readRDS("data/all_osf_file_info_psych_science.rds")
links <- osf_links(xml)
osf_files_summary <- summarize_contents(all_osf_file_info_psych_science)
# Remove rows referring to badges
osf_files_summary <- subset(osf_files_summary, is.na(text) | !(text %in% c("osf.io/tvyxz/", "osf.io/tvyxz")))
# Create a dataframe with unique rows based on both osf_id and download_url
unique_files <- osf_files_summary[!duplicated(osf_files_summary["osf_id"]), ]
# Count occurrences of each osf_id
id_counts <- table(unique_files$osf_id)
# Get osf_ids that appear more than once
duplicate_ids <- names(id_counts[id_counts > 1])
# Should be 0
length(duplicate_ids)
registrations_only <- subset(unique_files, osf_type == "registrations")
files_only <- subset(unique_files, osf_type == "files")
View(files_only)
files_only$name
